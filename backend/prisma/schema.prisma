generator client {
  provider = "prisma-client"
  output = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum OtpPurpose {
  register
  login
}

model User {
  id String @id @default(uuid())
  phone String @unique
  iin String @unique
  firstName String
  lastName String
  patronymic String?
  email String?
  phoneVerifiedAt DateTime
  consentAt DateTime
  blocked Boolean @default(false)
  createdAt DateTime @default(now())
  sessions Session[]
}

model OtpChallenge {
  id String @id
  phone String
  purpose OtpPurpose
  codeHash String
  ipHash String
  attempts Int @default(0)
  createdAt DateTime @default(now())
  expiresAt DateTime
  deliveredAt DateTime?
  consumedAt DateTime?
  @@index([phone, createdAt])
  @@index([ipHash, createdAt])
  @@index([expiresAt])
}

model Session {
  id String @id @default(uuid())
  tokenHash String @unique
  userId String
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model Territory {
  id String @id
  kind String
  name Json
  organizations OrganizationTerritory[]
}

model Organization {
  id String @id
  name Json
  sector String
  servesAll Boolean @default(false)
  territories OrganizationTerritory[]
  services Service[]
}

model OrganizationTerritory {
  organizationId String
  territoryId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  territory Territory @relation(fields: [territoryId], references: [id], onDelete: Restrict)
  @@id([organizationId, territoryId])
  @@index([territoryId])
}

model Category {
  id String @id
  name Json
  services Service[]
}

model Situation {
  id String @id
  name Json
  summary Json
  services Service[]
}

model Service {
  id String @id
  slug String @unique
  code String @unique
  situationId String
  categoryId String
  organizationId String
  audiences String[]
  title Json
  fullTitle Json?
  summary Json
  free Boolean
  searchText String
  workingDays Int
  channel String
  popular Boolean @default(false)
  isNew Boolean @default(false)
  updatedAt DateTime @db.Date
  situation Situation @relation(fields: [situationId], references: [id], onDelete: Restrict)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  @@index([categoryId])
  @@index([situationId])
}
