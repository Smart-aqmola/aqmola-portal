generator client {
  provider = "prisma-client"
  output = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum OtpPurpose {
  register
  login
}

enum Role {
  resident
  representative
  tenant
  lawful_user
  provider_employee
  contact_operator
  request_specialist
  inspector
  meter_specialist
  accountant
  organization_admin
  system_admin
}

model User {
  id String @id @default(uuid())
  phone String @unique
  iin String @unique
  firstName String
  lastName String
  middleName String? @map("patronymic")
  email String?
  phoneVerifiedAt DateTime
  consentAt DateTime
  blocked Boolean @default(false)
  roles Role[] @default([resident])
  organizationId String?
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  version Int @default(1)
  createdAt DateTime @default(now())
  sessions Session[]
  auditEntries AuditEntry[]
  properties Property[]
  contractApplications ContractApplication[]
}

model OtpChallenge {
  id String @id
  phone String
  purpose OtpPurpose
  codeHash String
  ipHash String
  attempts Int @default(0)
  createdAt DateTime @default(now())
  expiresAt DateTime
  deliveredAt DateTime?
  consumedAt DateTime?
  @@index([phone, createdAt])
  @@index([ipHash, createdAt])
  @@index([expiresAt])
}

model Session {
  id String @id @default(uuid())
  tokenHash String @unique
  userId String
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model AuditEntry {
  id String @id @default(uuid())
  userId String
  action String
  entityType String
  entityId String
  before Json
  after Json
  at DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, at])
  @@index([entityType, entityId])
}

model Territory {
  id String @id
  kind String
  name Json
  organizations OrganizationTerritory[]
  properties Property[]
  addresses Address[]
}

enum PropertyType {
  apartment
  house
  non_residential
  other
}

enum PropertyRelation {
  owner
  representative
  tenant
  lawful_user
}

model Property {
  id String @id @default(uuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  territoryId String
  territory Territory @relation(fields: [territoryId], references: [id], onDelete: Restrict)
  locality String
  street String
  house String
  flat String?
  type PropertyType
  relation PropertyRelation
  personalAccount String?
  ownerInfo String
  addressId String?
  verification Json @default("{\"status\":\"unverified\",\"documents\":[]}")
  version Int @default(1)
  createdAt DateTime @default(now())
  documents Attachment[]
  contractApplications ContractApplication[]
  @@index([ownerId, createdAt])
  @@index([territoryId])
}

model Attachment {
  id String @id @default(uuid())
  propertyId String
  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  name String
  mimeType String
  size Int
  sha256 String
  uploadedAt DateTime @default(now())
  @@index([propertyId])
}

model Organization {
  id String @id
  name Json
  sector String
  servesAll Boolean @default(false)
  blocked Boolean @default(false)
  version Int @default(1)
  employees User[]
  territories OrganizationTerritory[]
  services Service[]
  contractApplications ContractApplication[]
}

model OrganizationTerritory {
  organizationId String
  territoryId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  territory Territory @relation(fields: [territoryId], references: [id], onDelete: Restrict)
  @@id([organizationId, territoryId])
  @@index([territoryId])
}

model Category {
  id String @id
  name Json
  services Service[]
}

model Situation {
  id String @id
  name Json
  summary Json
  services Service[]
}

model Service {
  id String @id
  slug String @unique
  code String @unique
  situationId String
  categoryId String
  organizationId String
  audiences String[]
  title Json
  fullTitle Json?
  summary Json
  free Boolean
  searchText String
  contractApplications ContractApplication[]
  workingDays Int
  channel String
  popular Boolean @default(false)
  isNew Boolean @default(false)
  updatedAt DateTime @db.Date
  situation Situation @relation(fields: [situationId], references: [id], onDelete: Restrict)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  @@index([categoryId])
  @@index([situationId])
}

model Address {
  id String @id
  territoryId String
  territory Territory @relation(fields: [territoryId], references: [id], onDelete: Restrict)
  locality Json
  street Json
  without String[] @default([])
  searchText String
  @@index([territoryId])
}

enum ContractApplicationStatus {
  draft
  not_sent
  registered
  under_review
  docs_check_required
  returned_for_revision
  awaiting_applicant_signature
  awaiting_provider_signature
  inspection_required
  technical_conditions_required
  concluded
  active
  suspended
  terminated
  refused
}

model ContractApplication {
  id String @id @default(uuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  propertyId String
  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  serviceId String
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  providerId String
  provider Organization @relation(fields: [providerId], references: [id], onDelete: Restrict)
  status ContractApplicationStatus @default(draft)
  draft Json
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  @@index([ownerId, updatedAt])
  @@index([propertyId])
  @@index([serviceId])
  @@index([providerId, status])
}
