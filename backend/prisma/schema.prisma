generator client {
  provider = "prisma-client"
  output = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum OtpPurpose {
  register
  login
}

enum Role {
  resident
  representative
  tenant
  lawful_user
  provider_employee
  contact_operator
  request_specialist
  inspector
  meter_specialist
  accountant
  organization_admin
  system_admin
}

model User {
  id String @id @default(uuid())
  phone String @unique
  iin String @unique
  firstName String
  lastName String
  middleName String? @map("patronymic")
  email String?
  phoneVerifiedAt DateTime
  consentAt DateTime
  blocked Boolean @default(false)
  roles Role[] @default([resident])
  organizationId String?
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  version Int @default(1)
  createdAt DateTime @default(now())
  sessions Session[]
  auditEntries AuditEntry[]
}

model OtpChallenge {
  id String @id
  phone String
  purpose OtpPurpose
  codeHash String
  ipHash String
  attempts Int @default(0)
  createdAt DateTime @default(now())
  expiresAt DateTime
  deliveredAt DateTime?
  consumedAt DateTime?
  @@index([phone, createdAt])
  @@index([ipHash, createdAt])
  @@index([expiresAt])
}

model Session {
  id String @id @default(uuid())
  tokenHash String @unique
  userId String
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model AuditEntry {
  id String @id @default(uuid())
  userId String
  action String
  entityType String
  entityId String
  before Json
  after Json
  at DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, at])
  @@index([entityType, entityId])
}

model Territory {
  id String @id
  kind String
  name Json
  organizations OrganizationTerritory[]
}

model Organization {
  id String @id
  name Json
  sector String
  servesAll Boolean @default(false)
  blocked Boolean @default(false)
  version Int @default(1)
  employees User[]
  territories OrganizationTerritory[]
  services Service[]
}

model OrganizationTerritory {
  organizationId String
  territoryId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  territory Territory @relation(fields: [territoryId], references: [id], onDelete: Restrict)
  @@id([organizationId, territoryId])
  @@index([territoryId])
}

model Category {
  id String @id
  name Json
  services Service[]
}

model Situation {
  id String @id
  name Json
  summary Json
  services Service[]
}

model Service {
  id String @id
  slug String @unique
  code String @unique
  situationId String
  categoryId String
  organizationId String
  audiences String[]
  title Json
  fullTitle Json?
  summary Json
  free Boolean
  searchText String
  workingDays Int
  channel String
  popular Boolean @default(false)
  isNew Boolean @default(false)
  updatedAt DateTime @db.Date
  situation Situation @relation(fields: [situationId], references: [id], onDelete: Restrict)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  @@index([categoryId])
  @@index([situationId])
}
