{
  "name": "aqmola-api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "generate": "prisma generate",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/src/main.js",
    "dev": "pnpm build && pnpm start",
    "db:local": "node --env-file=.env scripts/local-db.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "test": "node --env-file=.env --test test/*.test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^18.0.8",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "embedded-postgres": "17.10.0-beta.17",
    "prisma": "7.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
